<?xml version="1.0" encoding="utf-8"?>
<!-- A status-bar icon is drawn from its alpha channel and tinted by the system, so this
     is the mark as a white silhouette, not the artwork. A photograph of a purple brush
     stroke in the status bar is a solid white block. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/sankalp_notification"
    android:gravity="fill"
    android:filter="true" />
