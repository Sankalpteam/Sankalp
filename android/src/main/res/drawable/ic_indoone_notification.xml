<?xml version="1.0" encoding="utf-8"?>
<!-- A notification icon is drawn from its alpha channel and painted by the system, so the
     colour in the PNG does not matter and the shape does. This is the same mark, so the
     notification and the app cannot look like two products. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/sankalp_mark"
    android:gravity="center"
    android:filter="true" />
