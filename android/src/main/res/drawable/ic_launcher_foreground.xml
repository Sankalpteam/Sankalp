<?xml version="1.0" encoding="utf-8"?>
<!-- The mark, from the one PNG every icon in this app is generated from.

     It was a vector of a rotated diamond before. A brush stroke cannot be a vector without
     losing the edge that makes it a brush stroke, so the art is a bitmap and the shape lives
     in one file: change sankalp_mark.png and the launcher, the splash, the in-app logo and the
     notification icon all change with it. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/sankalp_mark"
    android:gravity="center"
    android:filter="true" />
