<?xml version="1.0" encoding="utf-8"?>
<!-- The mark for the launcher, at 58% of the 108dp box.

     A launcher masks this to a shape - round, squircle, teardrop - and only the middle 66dp is
     guaranteed to survive. The splash can use a bigger copy because nothing masks it; this one
     cannot, or the outer loops of the stroke disappear on a round icon. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/sankalp_launcher"
    android:gravity="center"
    android:filter="true" />
