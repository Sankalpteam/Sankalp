<?xml version="1.0" encoding="utf-8"?>
<!-- The Android 12+ splash icon: the mark, centred on white, in the same 160dp box the
     pre-12 window background uses so the two versions look identical. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/indoone_splash_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/indoone_splash_logo" />
</layer-list>
