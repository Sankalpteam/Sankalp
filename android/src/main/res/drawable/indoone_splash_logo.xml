<?xml version="1.0" encoding="utf-8"?>
<!-- The splash mark: the artwork on transparent, 160dp square, from drawable-<density>/.

     Nothing masks a splash icon, so this box is larger than the launcher's and the mark
     reads at about a third of a phone's width. `fill` keeps the image inside the box
     instead of drawing it at its own size, which is what cropped the loops before. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/sankalp_splash"
    android:gravity="fill"
    android:filter="true" />
