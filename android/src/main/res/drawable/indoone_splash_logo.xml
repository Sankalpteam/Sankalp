<?xml version="1.0" encoding="utf-8"?>
<!-- 108 by 108 pixels in nodpi, which is 108dp on every screen: exactly the box a splash icon
     and an adaptive-icon foreground are given. The mark was a wide PNG before, and a bitmap
     drawable is placed at its own size rather than shrunk to fit - so the splash showed the
     middle of the stroke with both loops cut off. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/sankalp_mark"
    android:gravity="center"
    android:filter="true" />
