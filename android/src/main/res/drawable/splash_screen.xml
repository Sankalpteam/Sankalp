<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-Android-12 splash: the mark, centred on white. The purple diamond glow that
     used to sit behind it is gone - on a white field a violet glow reads as a smudge,
     not as light. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/indoone_splash_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/indoone_splash_logo" />
</layer-list>
