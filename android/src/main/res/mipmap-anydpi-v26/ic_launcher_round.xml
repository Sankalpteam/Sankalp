<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive round icon, for API 26 and up.

     android:roundIcon pointed at a legacy PNG. On API 26+ a launcher that asks for the round
     icon then got the bitmap instead of the adaptive icon, so it was drawn without the
     launcher's own shape and tinting - the one place where a themed launcher showed the old
     artwork. This is the same layers as ic_launcher.xml; the launcher applies the round mask
     itself, which is why nothing here is pre-masked. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/indoone_icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
